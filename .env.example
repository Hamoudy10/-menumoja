# Backend API URL — set this to your Render backend URL for production builds
# Example: VITE_API_URL=https://menumoja-backend.onrender.com/api/v1
# Leave empty for local development (uses Vite proxy -> localhost:3001)
VITE_API_URL=

# Google OAuth
# VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Google OAuth (optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

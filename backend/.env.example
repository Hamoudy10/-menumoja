# Database
DATABASE_URL=postgresql://user:password@localhost:5432/menumoja
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=your-access-secret-here-minimum-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-here-minimum-32-chars
ENCRYPTION_KEY=aes-256-cbc-encryption-key-32chars!!

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI Provider (OpenAI-compatible — works with DeepSeek, OpenAI, etc.)
# Set AI_PROVIDER=deepseek and DEEPSEEK_API_KEY to use DeepSeek
# Set OPENAI_API_KEY to use OpenAI (default)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=sk-your-openai-key

# Safaricom Daraja (M-Pesa)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://api.menumoja.co.ke/api/v1/payments/mpesa/callback

# Africa's Talking
AT_API_KEY=your-at-api-key
AT_USERNAME=sandbox
AT_USSD_CODE=*384*001#
AT_SENDER_ID=MenuMoja

# Meta / WhatsApp
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id

# Google
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Resend
RESEND_API_KEY=re-your-resend-key

# Sentry
SENTRY_DSN=https://key@o1.ingest.sentry.io/123

# App Config
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001
ADMIN_EMAIL=admin@menumoja.co.ke

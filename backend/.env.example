# Database
DATABASE_URL=postgresql://user:password@localhost:5432/menumoja
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=your-access-secret-here-minimum-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-here-minimum-32-chars
ENCRYPTION_KEY=aes-256-cbc-encryption-key-32chars!!

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI Provider (OpenAI-compatible — works with DeepSeek, OpenAI, etc.)
# Set AI_PROVIDER=deepseek and DEEPSEEK_API_KEY to use DeepSeek
# Set OPENAI_API_KEY to use OpenAI (default)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=sk-your-openai-key

# Voice / speech-to-text (AI Command "Jarvis" — Phase B)
# Leave empty to disable voice; the /ai/command/transcribe endpoint then
# returns 503 and clients fall back to typing.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# AI Command ("Jarvis") access policy. Advanced AI is admin-only for now.
# Default: restaurant owner + platform super-admin. Staff roles (manager,
# cashier, waiter, kitchen) stay on the manual UI.
# Widen later with e.g.: AI_COMMAND_ALLOWED_ROLES=owner,manager
AI_COMMAND_ALLOWED_ROLES=owner,super_admin
# Maximum tool steps in a single multi-step plan (1-6).
AI_COMMAND_MAX_STEPS=4

# Proactive alerts (deterministic; no LLM). See docs/PROACTIVE_ALERTS.md.
PROACTIVE_ALERTS_ENABLED=true
PROACTIVE_INTERVAL_MS=300000
PROACTIVE_WAITING_ORDER_MINUTES=20
PROACTIVE_LOW_STOCK_DEDUPE_HOURS=6
PROACTIVE_WAITING_DEDUPE_MINUTES=20
PROACTIVE_EXPIRY_WINDOW_DAYS=3
PROACTIVE_BRIEFING_HOUR=7
PROACTIVE_MAX_RESTAURANTS=500

# Safaricom Daraja (M-Pesa)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://api.menumoja.co.ke/api/v1/payments/mpesa/callback

# Africa's Talking
AT_API_KEY=your-at-api-key
AT_USERNAME=sandbox
AT_USSD_CODE=*384*001#
AT_SENDER_ID=MenuMoja

# Meta / WhatsApp
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id

# Google
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Resend
RESEND_API_KEY=re-your-resend-key

# Sentry
SENTRY_DSN=https://key@o1.ingest.sentry.io/123

# App Config
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001
ADMIN_EMAIL=admin@menumoja.co.ke

# === RENDER DEPLOYMENT NOTES ===
# Deploy with `render.yaml` at repo root.
# Set these as Environment Variables in Render dashboard -> your service -> Environment:
#   NODE_ENV=production
#   FRONTEND_URL=https://menumoja.vercel.app
#   API_URL=https://menumoja-backend.onrender.com
#   DATABASE_URL (copy from your current backend/.env)
#   JWT_ACCESS_SECRET (same as current .env)
#   JWT_REFRESH_SECRET (same as current .env)
#   ENCRYPTION_KEY (same as current .env)
#   DEEPSEEK_API_KEY (same as current .env)
# Optional: REDIS_URL, CLOUDINARY_*, MPESA_*, etc.
#
# Render free tier spins down after 15 min of inactivity (auto-wakes on request).
# That's fine for dev/demo — upgrade only if you need always-on.

# -- KRA eTIMS (Electronic Tax Invoice Management System) --
# NOT COMPLIANCE: receipts are only ever reported as SUBMITTED to KRA after
# the KRA sandbox returns an invoice number. Leave unset to keep submissions
# PENDING (surfaced in the dashboard). Verify the current KRA API contract
# (docs/ETIMS.md) before activating.
ETIMS_ENV=sandbox
ETIMS_USERNAME=
ETIMS_PASSWORD=
ETIMS_BRANCH_ID=00
ETIMS_DEVICE_SERIAL=
ETIMS_DEVICE_ID=

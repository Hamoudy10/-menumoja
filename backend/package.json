{
  "name": "menumoja-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MenuMoja — Multi-tenant SaaS restaurant management platform backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "npx prisma generate && node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "jest --passWithNoTests --forceExit",
    "test:watch": "jest --watch --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.24.0",
    "socket.io": "^4.8.0",
    "bullmq": "^5.47.0",
    "ioredis": "^5.5.0",
    "axios": "^1.7.0",
    "date-fns": "^4.1.0",
    "uuid": "^10.0.0",
    "multer": "^2.0.0",
    "sharp": "^0.33.0",
    "qrcode": "^1.5.4",
    "pdfkit": "^0.16.0",
    "cloudinary": "^2.6.0",
    "openai": "^4.86.0",
    "express-rate-limit": "^7.5.0",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "winston": "^3.17.0",
    "@sentry/node": "^8.54.0",
    "dotenv": "^16.4.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/crypto-js": "^4.2.2",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}

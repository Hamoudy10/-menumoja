generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  relationMode = "prisma"
}

// ==============================
// ENUMS
// ==============================

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  TRIAL
  SUSPENDED
}

enum LayoutStyle {
  GRID
  LIST
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  VERY_HOT
}

enum QRType {
  TABLE
  GENERAL
  TAKEAWAY
}

enum StaffRole {
  WAITER
  CASHIER
  KITCHEN
  MANAGER
  OWNER
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  UNAVAILABLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum OrderPaymentMethod {
  MPESA
  CASH
  CARD
  SPLIT
  PENDING
}

enum PaymentMethod {
  MPESA
  CASH
  CARD
}

enum CashStatus {
  OPEN
  CLOSED
  DISCREPANCY_FLAGGED
}

enum ConversationType {
  CUSTOMER_CHAT
  OWNER_SETUP
}

enum AIContentType {
  MENU_DESCRIPTION
  SOCIAL_POST
  RESTAURANT_DESC
  IMAGE
}

enum AlertType {
  MOTION_AFTER_HOURS
  UNATTENDED_TABLE
  CASH_AREA_ACTIVITY
  CAPACITY_HIGH
  STAFF_ABSENT
}

enum SmsDirection {
  INBOUND
  OUTBOUND
}

enum SmsStatus {
  SENT
  DELIVERED
  FAILED
}

enum RecipientType {
  OWNER
  STAFF
  PLATFORM_ADMIN
}

enum NotificationType {
  NEW_ORDER
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  LOW_STOCK
  CAMERA_ALERT
  SOCIAL_POST_PUBLISHED
  REVIEW_RECEIVED
  SUBSCRIPTION_EXPIRING
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
  REVERSED
  UNKNOWN
}

enum UnitOfMeasure {
  KG
  G
  L
  ML
  PIECE
  PACK
  BOX
  DOZEN
  BAG
  JAR
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  WASTE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum StockMovementReference {
  PURCHASE_ORDER
  ORDER
  MANUAL
  OPENING
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum CustomerSource {
  QR
  POS
  SMS
  USSD
  MANUAL
}

// ==============================
// MODELS
// ==============================

model PlatformAdmin {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  email        String             @unique
  passwordHash String             @map("password_hash")
  role         PlatformAdminRole
  lastLogin    DateTime?          @map("last_login")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@map("platform_admins")
}

model SubscriptionPlan {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  priceMonthlyKes  Decimal  @map("price_monthly_kes") @db.Decimal(10, 2)
  priceYearlyKes   Decimal  @map("price_yearly_kes") @db.Decimal(10, 2)
  maxMenuItems     Int?     @map("max_menu_items")
  maxTables        Int?     @map("max_tables")
  hasOrdering      Boolean  @default(false) @map("has_ordering")
  hasAnalytics     Boolean  @default(false) @map("has_analytics")
  hasSurveillance  Boolean  @default(false) @map("has_surveillance")
  hasUssd          Boolean  @default(false) @map("has_ussd")
  hasMultiBranch   Boolean  @default(false) @map("has_multi_branch")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  restaurants Restaurant[]

  @@map("subscription_plans")
}

model Owner {
  id                  String    @id @default(uuid()) @db.Uuid
  fullName            String    @map("full_name")
  email               String    @unique
  phone               String    @unique
  passwordHash        String    @map("password_hash")
  isVerified          Boolean   @default(false) @map("is_verified")
  otpCode             String?   @map("otp_code")
  otpExpiresAt        DateTime? @map("otp_expires_at")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  onboardingStep      Int       @default(1) @map("onboarding_step")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  restaurants Restaurant[]

  @@map("owners")
}

model Restaurant {
  id                 String             @id @default(uuid()) @db.Uuid
  ownerId            String             @map("owner_id") @db.Uuid
  name               String
  slug               String             @unique
  description        String
  descriptionSw      String?            @map("description_sw")
  logoUrl            String?            @map("logo_url")
  coverPhotoUrl      String?            @map("cover_photo_url")
  coverVideoUrl      String?            @map("cover_video_url")
  address            String
  city               String             @default("Mombasa")
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  phone              String
  whatsapp           String?
  email              String?
  website            String?
  kraPin             String?        @map("kra_pin")
  businessRegNo      String?        @map("business_reg_no")
  vatRegNo           String?        @map("vat_reg_no")
  businessType       String?        @default("Restaurant") @map("business_type")
  county             String?        @default("Mombasa")
  currency           String         @default("KES")
  isHalalCertified   Boolean            @default(false) @map("is_halal_certified")
  dietaryOptions     String[]           @map("dietary_options")
  isActive           Boolean            @default(true) @map("is_active")
  isSuspended        Boolean            @default(false) @map("is_suspended")
  suspensionReason   String?            @map("suspension_reason")
  planId             String             @map("plan_id") @db.Uuid
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  planExpiresAt      DateTime?          @map("plan_expires_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  owner                  Owner                  @relation(fields: [ownerId], references: [id])
  plan                   SubscriptionPlan       @relation(fields: [planId], references: [id])
  settings               RestaurantSettings?
  openingHours           OpeningHour[]
  branches               RestaurantBranch[]
  menuCategories         MenuCategory[]
  menuItems              MenuItem[]
  dailySpecials          DailySpecialSchedule[]
  promotions             Promotion[]
  qrCodes                QrCode[]
  qrScans                QrScan[]
  staff                  Staff[]
  staffShifts            StaffShift[]
  tables                 RestaurantTable[]
  tableZones             TableZone[]
  tableSessions          TableSession[]
  orders                 Order[]
  payments               Payment[]
  paymentAttempts        PaymentAttempt[]
  paymentWebhookEvents   PaymentWebhookEvent[]
  reconciliationRecords  ReconciliationRecord[]
  cashReconciliations    CashReconciliation[]
  receipts               Receipt[]
  inventoryItems         InventoryItem[]
  stockMovements         StockMovement[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  recipes                Recipe[]
  customers              Customer[]
  aiConversations        AiConversation[]
  faqs                   RestaurantFaq[]
  aiGeneratedContents    AiGeneratedContent[]
  cameras                Camera[]
  cameraAlerts           CameraAlert[]
  analyticsDaily         AnalyticsDaily[]
  menuItemAnalytics      MenuItemAnalytics[]
  searchAnalytics        SearchAnalytics[]
  ussdSessions           UssdSession[]
  smsLogs                SmsLog[]
  notifications          Notification[]
  auditLogs              AuditLog[]

  @@index([ownerId])
  @@index([planId])
  @@index([slug])
  @@map("restaurants")
}

model RestaurantSettings {
  id                   String       @id @default(uuid()) @db.Uuid
  restaurantId         String       @unique @map("restaurant_id") @db.Uuid
  primaryColor         String       @default("#2563EB") @map("primary_color")
  secondaryColor       String       @default("#F59E0B") @map("secondary_color")
  fontFamily           String       @default("Inter") @map("font_family")
  gradientStart        String?      @map("gradient_start")
  gradientEnd          String?      @map("gradient_end")
  useGradient          Boolean      @default(false) @map("use_gradient")
  headingFont          String?      @map("heading_font")
  bodyFont             String?      @map("body_font")
  accentFont           String?      @map("accent_font")
  layoutStyle          LayoutStyle  @default(GRID) @map("layout_style")
  welcomeMessage       String?      @map("welcome_message")
  welcomeMessageSw     String?      @map("welcome_message_sw")
  announcement         String?
  announcementActive   Boolean      @default(false) @map("announcement_active")
  languageEnglish      Boolean      @default(true) @map("language_english")
  languageSwahili      Boolean      @default(false) @map("language_swahili")
  languageArabic       Boolean      @default(false) @map("language_arabic")
  showPrices           Boolean      @default(true) @map("show_prices")
  allowOrdering        Boolean      @default(false) @map("allow_ordering")
  allowCashPayment     Boolean      @default(true) @map("allow_cash_payment")
  allowMpesaPayment    Boolean      @default(false) @map("allow_mpesa_payment")
  tipEnabled           Boolean      @default(false) @map("tip_enabled")
  tipPercentages       Int[]        @map("tip_percentages")
  serviceChargePercent Decimal     @default(0) @map("service_charge_percent") @db.Decimal(5, 2)
  taxPercent           Decimal      @default(0) @map("tax_percent") @db.Decimal(5, 2)
  mpesaShortcode       String?      @map("mpesa_shortcode")
  mpesaPasskey         String?      @map("mpesa_passkey")
  mpesaBusinessName    String?      @map("mpesa_business_name")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

model OpeningHour {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  dayOfWeek    DayOfWeek @map("day_of_week")
  openTime     String    @map("open_time")
  closeTime    String    @map("close_time")
  isClosed     Boolean   @default(false) @map("is_closed")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("opening_hours")
}

model RestaurantBranch {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchName   String   @map("branch_name")
  address      String
  phone        String
  managerName  String?  @map("manager_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_branches")
}

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  nameSw       String?  @map("name_sw")
  nameAr       String?  @map("name_ar")
  description  String?
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id                      String     @id @default(uuid()) @db.Uuid
  restaurantId            String     @map("restaurant_id") @db.Uuid
  categoryId              String     @map("category_id") @db.Uuid
  name                    String
  nameSw                  String?    @map("name_sw")
  nameAr                  String?    @map("name_ar")
  description             String
  descriptionSw           String?    @map("description_sw")
  descriptionAr           String?    @map("description_ar")
  price                   Decimal    @db.Decimal(10, 2)
  currency                String     @default("KES")
  photoUrl                String?    @map("photo_url")
  photoUrls               String[]   @map("photo_urls")
  photoGeneratedByAi      Boolean    @default(false) @map("photo_generated_by_ai")
  isAvailable             Boolean    @default(true) @map("is_available")
  isTodaysSpecial         Boolean    @default(false) @map("is_todays_special")
  isFeatured              Boolean    @default(false) @map("is_featured")
  isNew                   Boolean    @default(false) @map("is_new")
  preparationTimeMinutes  Int?       @map("preparation_time_minutes")
  calories                Int?
  isHalal                 Boolean    @default(false) @map("is_halal")
  isVegetarian            Boolean    @default(false) @map("is_vegetarian")
  isVegan                 Boolean    @default(false) @map("is_vegan")
  isGlutenFree            Boolean    @default(false) @map("is_gluten_free")
  spiceLevel              SpiceLevel @default(NONE) @map("spice_level")
  containsNuts            Boolean    @default(false) @map("contains_nuts")
  containsDairy           Boolean    @default(false) @map("contains_dairy")
  containsSeafood         Boolean    @default(false) @map("contains_seafood")
  allergenNotes           String?    @map("allergen_notes")
  ingredients             String[]
  sortOrder               Int        @default(0) @map("sort_order")
  totalOrders             Int        @default(0) @map("total_orders")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category      MenuCategory       @relation(fields: [categoryId], references: [id])
  suggestions   MenuItemSuggestion[]  @relation("MenuItemSuggestions")
  suggestedBy   MenuItemSuggestion[]  @relation("SuggestedByMenuItems")
  dailySpecials DailySpecialSchedule[]
  promotions    Promotion[]
  orderItems    OrderItem[]
  menuItemAnalytics MenuItemAnalytics[]
  recipes       Recipe[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemSuggestion {
  id              String @id @default(uuid()) @db.Uuid
  itemId          String @map("item_id") @db.Uuid
  suggestedItemId String @map("suggested_item_id") @db.Uuid

  item          MenuItem @relation("MenuItemSuggestions", fields: [itemId], references: [id], onDelete: Cascade)
  suggestedItem MenuItem @relation("SuggestedByMenuItems", fields: [suggestedItemId], references: [id], onDelete: Cascade)

  @@unique([itemId, suggestedItemId])
  @@index([itemId])
  @@index([suggestedItemId])
  @@map("menu_item_suggestions")
}

model DailySpecialSchedule {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  specialPrice Decimal?  @map("special_price") @db.Decimal(10, 2)
  startsAt     DateTime  @map("starts_at")
  endsAt       DateTime  @map("ends_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  item       MenuItem   @relation(fields: [itemId], references: [id])

  @@index([restaurantId])
  @@index([itemId])
  @@map("daily_specials_schedule")
}

enum PromotionType {
  SPECIAL
  OFFER
  EVENT
  GIVEAWAY
}

model Promotion {
  id            String        @id @default(uuid()) @db.Uuid
  restaurantId  String        @map("restaurant_id") @db.Uuid
  type          PromotionType @map("type")
  title         String        @map("title")
  description   String?       @map("description")
  descriptionSw String?       @map("description_sw")
  menuItemId    String?       @map("menu_item_id") @db.Uuid
  specialPrice  Decimal?      @map("special_price") @db.Decimal(10, 2)
  imageUrl      String?       @map("image_url")
  startsAt      DateTime?     @map("starts_at")
  endsAt        DateTime?     @map("ends_at")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?  @relation(fields: [menuItemId], references: [id])

  @@index([restaurantId])
  @@index([menuItemId])
  @@index([isActive])
  @@map("promotions")
}

model QrCode {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  label        String
  tableNumber  Int?     @map("table_number")
  qrType       QRType   @map("qr_type")
  qrImageUrl   String?  @map("qr_image_url")
  qrCardPdfUrl String?  @map("qr_card_pdf_url")
  targetUrl    String   @map("target_url")
  scanCount    Int      @default(0) @map("scan_count")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scans      QrScan[]
  tables     RestaurantTable[]
  orders     Order[]

  @@index([restaurantId])
  @@map("qr_codes")
}

model QrScan {
  id           String   @id @default(uuid()) @db.Uuid
  qrCodeId     String   @map("qr_code_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  scannedAt    DateTime @default(now()) @map("scanned_at")
  deviceType   String?  @map("device_type")
  browser      String?
  ipAddress    String?  @map("ip_address")
  sessionId    String   @map("session_id")
  languageUsed String?  @map("language_used")
  createdAt    DateTime @default(now()) @map("created_at")

  qrCode     QrCode     @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([qrCodeId])
  @@index([sessionId])
  @@index([scannedAt])
  @@map("qr_scans")
}

model Staff {
  id                String          @id @default(uuid()) @db.Uuid
  restaurantId      String          @map("restaurant_id") @db.Uuid
  employeeNumber    String?         @map("employee_number")
  fullName          String          @map("full_name")
  phone             String
  email             String?
  nationalId        String?         @map("national_id")
  kraPin            String?         @map("kra_pin")
  nhifNumber        String?         @map("nhif_number")
  nssfNumber        String?         @map("nssf_number")
  dateOfBirth       DateTime?       @map("date_of_birth")
  address           String?
  emergencyName     String?         @map("emergency_name")
  emergencyPhone    String?         @map("emergency_phone")
  emergencyRelation String?         @map("emergency_relation")
  nextOfKin         String?         @map("next_of_kin")
  nextOfKinPhone    String?         @map("next_of_kin_phone")
  nextOfKinRelation String?         @map("next_of_kin_relation")
  bankName          String?         @map("bank_name")
  bankBranch        String?         @map("bank_branch")
  bankAccount       String?         @map("bank_account")
  monthlySalary     Decimal?        @map("monthly_salary") @db.Decimal(10, 2)
  hourlyRate        Decimal?        @map("hourly_rate") @db.Decimal(10, 2)
  leaveDays         Int?            @default(21) @map("leave_days")
  startDate         DateTime?       @map("start_date")
  notes             String?         @db.Text
  pinHash           String          @map("pin_hash")
  role              StaffRole
  isActive          Boolean         @default(true) @map("is_active")
  lastLogin         DateTime?       @map("last_login")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  restaurant          Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shifts              StaffShift[]
  assignedOrders      Order[]         @relation("WaiterOrders")
  cashierPayments     Payment[]       @relation("CashierPayments")
  reconciliations     CashReconciliation[]
  receipts            Receipt[]

  @@index([restaurantId])
  @@map("staff")
}

model StaffShift {
  id           String    @id @default(uuid()) @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  clockIn      DateTime  @map("clock_in")
  clockOut     DateTime? @map("clock_out")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([staffId])
  @@index([restaurantId])
  @@map("staff_shifts")
}

model RestaurantTable {
  id               String       @id @default(uuid()) @db.Uuid
  restaurantId     String       @map("restaurant_id") @db.Uuid
  tableNumber      Int          @map("table_number")
  label            String
  capacity         Int?
  status           TableStatus  @default(FREE)
  area             String?      @map("area")
  shape            String?      @default("ROUND") @map("shape")
  positionX        Int          @default(0) @map("position_x")
  positionY        Int          @default(0) @map("position_y")
  width            Int          @default(2) @map("width")
  height           Int          @default(2) @map("height")
  rotation         Int          @default(0) @map("rotation")
  zoneId           String?      @map("zone_id") @db.Uuid
  currentSessionId String?      @map("current_session_id")
  qrCodeId         String?      @map("qr_code_id")
  version          Int          @default(0)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone       TableZone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  qrCode     QrCode?         @relation(fields: [qrCodeId], references: [id])
  orders     Order[]
  sessions   TableSession[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@index([zoneId])
  @@index([qrCodeId])
  @@map("restaurant_tables")
}

model TableZone {
  id           String            @id @default(uuid()) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  name         String
  color        String            @default("#E2E8F0")
  positionX    Int               @default(0) @map("position_x")
  positionY    Int               @default(0) @map("position_y")
  width        Int               @default(12) @map("width")
  height       Int               @default(8) @map("height")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     RestaurantTable[]

  @@index([restaurantId])
  @@map("table_zones")
}

model TableSession {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  tableId      String     @map("table_id") @db.Uuid
  guestCount   Int?       @map("guest_count")
  startedAt    DateTime   @default(now()) @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
